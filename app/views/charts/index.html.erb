<div class="container m-2">

<h1>Listing charts</h1>

<%= Regit.find(params[:regit_id]).name %>
</br>
<%= link_to 'New Chart', new_regit_chart_path, class: "btn btn-sm btn-outline-dark outline-double rounded-pill px-2 py-0 m-1 fw-bold" %>

<table class="table table-sm table-striped table-hover mt-1">
  <tr>
    <th>T date</th>
    <th>Subj</th>
    <th>Obj</th>
    <th></th>
    <th></th>
    <th></th>
  </tr>

<% @charts.each do |chart| %>
  <tr>
    <td><%= chart.t_date %></td>
    <td><%= chart.subj %></td>
    <td><%= chart.obj %></td>
    <td><%= link_to 'Show', [chart.regit, chart] %></td>
    <td><%= link_to 'Edit', edit_regit_chart_path(chart.regit, chart) %></td>
    <td><%= link_to 'Destroy', [chart.regit, chart], method: :delete, data: { confirm: 'Are you sure?' } %></td>
  </tr>
<% end %>
</table>

<br />

<%= link_to 'New Chart', new_regit_chart_path(params[:regit_id]) %>
</div>